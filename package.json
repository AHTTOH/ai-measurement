{
  "name": "ai-measurement",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "shared",
    "infra",
    "server",
    "grading",
    "web"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "test": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "npm run test && npm run test:integration",
    "test:e2e": "npm run build:web && playwright test --config tests/e2e/playwright.config.ts",
    "db:dev": "tsx --env-file=.env scripts/start-dev-database.ts",
    "db:generate": "npm run generate --workspace infra --",
    "db:migrate": "tsx --env-file=.env scripts/migrate-database.ts",
    "db:logins": "tsx --env-file=.env scripts/apply-database-logins.ts",
    "dev:candidate-server": "tsx watch --env-file=.env server/src/candidate-main.ts",
    "dev:admin-server": "tsx watch --env-file=.env server/src/admin-main.ts",
    "dev:web:candidate": "npm run dev:candidate --workspace web",
    "dev:web:admin": "npm run dev:admin --workspace web",
    "dev:worker": "tsx watch --env-file=.env grading/src/worker-main.ts",
    "build:web": "npm run build --workspace web",
    "start:candidate-server": "tsx --env-file=.env server/src/candidate-main.ts",
    "start:admin-server": "tsx --env-file=.env server/src/admin-main.ts",
    "start:worker": "tsx --env-file=.env grading/src/worker-main.ts",
    "admin:create": "tsx --env-file=.env scripts/create-admin.ts",
    "exam:validate": "tsx scripts/validate-exam-package.ts",
    "exam:build-sample": "tsx scripts/build-sample-exam-package.ts",
    "test:coverage": "vitest run --config vitest.coverage.config.ts --coverage"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@vitest/coverage-v8": "^5.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
