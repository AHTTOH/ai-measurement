# 환경변수 예시(최초 작성 2026-09-27, 권한 구조 분리·Supabase 반영 2026-09-27). 저장소 루트에 .env로 복사해 값을 채운다.
# 실제 .env는 커밋하지 않는다. 모든 항목이 필수다. 코드 쪽 기본값이 없으므로 빠지면 프로세스가 기동을 거부한다.
#
# 프로세스는 넷이다: 수험생 서버, 관리자 서버, 채점 워커, 그리고 관리 스크립트(마이그레이션·계정 생성).
# 각 프로세스는 자기 DB 계정으로만 접속한다(docs/decisions/2026-09-27-권한-구조-분리.md).
# 로컬 개발은 이 파일 하나를 모두 읽지만, 운영에서는 프로세스마다 필요한 항목만 담은 파일을 따로 둔다
# (docs/runbook/시험-운영-절차.md의 '프로세스별 환경 파일').

# ── DB 공통 ───────────────────────────────────────────
# 운영 DB는 Supabase(결정 D17). 풀러 세션 모드(5432)로 접속한다. 트랜잭션 모드(6543)는 LISTEN/NOTIFY가 안 되므로 쓰지 않는다
DATABASE_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DATABASE_PORT=5432
DATABASE_NAME=postgres
# require(Supabase) 또는 disable(로컬 임베디드 DB)
DATABASE_SSL=require
# Supabase 풀러 접속이면 프로젝트 ref. 접속 사용자 이름이 '계정.ref'가 된다. 로컬 DB면 이 줄을 지운다
DATABASE_POOLER_PROJECT_REF=프로젝트ref

# ── DB 계정: 스키마 소유자(마이그레이션·운영자 계정 생성·DB 로그인 적용 스크립트 전용) ──
# 서버·워커에는 주지 않는다
MIGRATION_DB_USER=aim_owner
MIGRATION_DB_PASSWORD=비밀번호

# ── DB 계정: 프로세스별 로그인. npm run db:logins가 만들고 역할에 넣는다 ──
# 이름: 영문 소문자·숫자·밑줄 3~63자. 비밀번호: 영문·숫자·_·- 16~128자. 세 계정은 서로 달라야 한다
CANDIDATE_SERVER_DB_USER=aim_candidate_login
CANDIDATE_SERVER_DB_PASSWORD=비밀번호-16자-이상
ADMIN_SERVER_DB_USER=aim_admin_login
ADMIN_SERVER_DB_PASSWORD=비밀번호-16자-이상
GRADING_WORKER_DB_USER=aim_grading_login
GRADING_WORKER_DB_PASSWORD=비밀번호-16자-이상

# ── 공통 ──────────────────────────────────────────────
# 시험 패키지 폴더(수험생 서버는 자료를 읽고, 관리자 서버는 패키지를 등록하고, 워커는 채점 자료를 읽는다)
EXAMS_DIR=./exams
# 채점 LLM: anthropic | mock. 관리자 서버(작업 생성)와 채점 워커(작업 처리)가 같은 값이어야 작업이 돈다
GRADING_LLM_PROVIDER=mock
# AI_PROVIDER 또는 GRADING_LLM_PROVIDER가 anthropic이면 필수. 관리자 서버에는 필요 없다
ANTHROPIC_API_KEY=

# 두 서버가 함께 쓰는 로그인 정책
# 같은 출처 검사에서 요청 주소로 볼 헤더: host(직접 받음) 또는 x-forwarded-host(Firebase Hosting 뒤)
REQUEST_HOST_HEADER=host
# HTTPS로 운영하면 true. 로컬 http 개발은 false
COOKIE_SECURE=false
# 로그인 유지 시간(시간)
AUTH_SESSION_HOURS=12
# 계정별 로그인 실패 허용 횟수와 잠금 시간(분)
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15
# 한 IP에서 1분에 받을 로그인 시도 수. 로그인마다 비싼 해시 계산이 돌아 과부하를 막는다.
# 시험장 전체가 한 IP(공유기·프록시)로 들어올 수 있으니 응시 인원의 몇 배로 넉넉히 둔다
LOGIN_ATTEMPTS_PER_IP_PER_MINUTE=600

# ── 수험생 서버 ───────────────────────────────────────
# 시험장 PC가 접속하므로 보통 0.0.0.0(모든 인터페이스)
CANDIDATE_SERVER_HOST=0.0.0.0
CANDIDATE_SERVER_PORT=3000
# 로그인 쿠키 이름. 로컬처럼 두 서버가 같은 호스트면 관리자와 달라야 한다. Firebase Hosting 뒤면 __session
CANDIDATE_SESSION_COOKIE=aim_candidate
# 커넥션 풀 크기
CANDIDATE_SERVER_DB_MAX_CONNECTIONS=10
# 응시용 AI: anthropic | mock (mock은 개발·테스트 전용, 화면에 '모의 AI'로 표시된다)
AI_PROVIDER=mock
# AI_PROVIDER=mock일 때만 필수: 모의 응답 조각 사이 지연(ms)
MOCK_AI_CHUNK_DELAY_MS=40
# 응시자 한 명이 1분에 보낼 수 있는 AI 요청 수(스크립트 남용 방지)
CANDIDATE_AI_REQUESTS_PER_MINUTE=20
# 시간이 지난 응시 세션을 정리하는 주기(초)
SESSION_SWEEP_SECONDS=15
# 빌드한 수험생 웹을 함께 제공하려면 아래 줄의 주석을 풀고 경로를 적는다. 줄이 없으면 API만 제공한다
# (값을 비운 채 두면 기동을 거부한다. 빈 값을 '없음'으로 해석하지 않는다)
# CANDIDATE_WEB_DIST_DIR=./web/dist/candidate

# ── 관리자 서버 ───────────────────────────────────────
# 운영 PC에서만 열도록 127.0.0.1을 권장한다. 다른 PC에서 운영하면 그 PC만 닿는 주소로 좁힌다
ADMIN_SERVER_HOST=127.0.0.1
ADMIN_SERVER_PORT=3001
ADMIN_SESSION_COOKIE=aim_admin
ADMIN_SERVER_DB_MAX_CONNECTIONS=3
# 시험 패키지 zip 업로드 한도(MB)
UPLOAD_MAX_MB=50
# 빌드한 관리자 웹을 함께 제공하려면 아래 줄의 주석을 풀고 경로를 적는다. 줄이 없으면 API만 제공한다
# ADMIN_WEB_DIST_DIR=./web/dist/admin

# ── 채점 워커 ─────────────────────────────────────────
GRADING_WORKER_DB_MAX_CONNECTIONS=3
# 대기 작업이 없을 때 큐를 다시 보는 간격(초)
GRADING_POLL_SECONDS=5
# 배치 결과를 다시 확인하는 간격(초)
GRADING_BATCH_POLL_SECONDS=60
# 즉시 모드 동시 요청 수
GRADING_DIRECT_CONCURRENCY=4
# 작업을 잡은 워커가 이 시간(분) 안에 끝내지 못하면 다른 워커가 다시 잡는다
GRADING_JOB_LOCK_MINUTES=30
# Cloud Run 서비스로 돌릴 때만: 상태 확인 HTTP 포트. 로컬에서는 이 줄을 두지 않는다
# GRADING_WORKER_HEALTH_PORT=8080

# ── 로컬 개발 전용 ────────────────────────────────────
# Vite 개발 서버가 /api를 넘길 주소. 수험생 화면(npm run dev:web:candidate)과 관리자 화면(npm run dev:web:admin)이 따로 뜬다
WEB_DEV_CANDIDATE_API_ORIGIN=http://localhost:3000
WEB_DEV_ADMIN_API_ORIGIN=http://localhost:3001
# scripts/start-dev-database.ts의 데이터 폴더. 포트·DB 이름·계정은 위 DATABASE_*, MIGRATION_DB_*를 쓴다
DEV_DATABASE_DIR=./workspace/dev-postgres

# ── Supabase 관리(결정 D17) ── Management API 액세스 토큰. 서버·워커에는 주지 않는다
SUPABASE_ACCESS_TOKEN=
